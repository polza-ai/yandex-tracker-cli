{
  "name": "@polza-ai/yandex-tracker-cli",
  "version": "0.11.0",
  "description": "CLI tool for Yandex Tracker — for humans and AI agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/polza-ai/yandex-tracker-cli.git"
  },
  "keywords": [
    "yandex",
    "tracker",
    "cli",
    "ai",
    "agent",
    "project-management"
  ],
  "type": "module",
  "bin": {
    "tracker": "dist/bin/tracker.js"
  },
  "scripts": {
    "build": "rolldown -c && tsc --emitDeclarationOnly",
    "dev": "node dist/bin/tracker.js",
    "test": "vitest run && npm run test:cli",
    "test:watch": "vitest",
    "lint": "oxlint src bin",
    "typecheck": "tsc --noEmit",
    "predev": "rolldown -c",
    "format": "oxfmt --write src bin",
    "format:check": "oxfmt --check src bin",
    "test:cli": "npm run build && node --test tests/cli.compat.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "axios": "^1.21.1",
    "chalk": "^6.0.1",
    "cli-table3": "^0.6.5",
    "commander": "^15.1.0",
    "dayjs": "^1.11.23",
    "form-data": "^4.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "rolldown": "^1.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
